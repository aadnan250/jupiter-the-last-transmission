  m_Script: {fileID: 11500000, guid: 00c313ed7574a19459cb30ce651f9d5b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Jupiter.Runtime::Jupiter.World.Readable
  title: 'Tiamat lander: recovered log'
  body: 'TIAMAT SURFACE PACKAGE: SEISMIC LOG (relayed copy)


    2171-03-14 04:12  Borehole B2 at 212 m. Instrument string nominal.

    2171-03-14 04:31  Periodic signal, 0.4 Hz. Four pulses, a gap, repeating. Flagged FEATURE 7.

    2171-03-14 05:02  FEATURE 7 amplitude rising. Signal tracking the drill''s own rhythm, delayed.

    2171-03-14 05:40  B2 pressure loss. Camera: borehole wall frosting over from below.

    2171-03-14 06:15  B2 sealed. Seal is not ice. Sample unrecoverable.

    2171-03-14 06:16  Data package classified at source by mission authority. Distribution: COMMAND ONLY.'
  setsFlag: read_tiamat_log
