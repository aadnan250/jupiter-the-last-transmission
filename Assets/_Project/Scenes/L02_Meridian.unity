  m_Script: {fileID: 11500000, guid: 00c313ed7574a19459cb30ce651f9d5b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Jupiter.Runtime::Jupiter.World.Readable
  title: 'Work order WO-117: Lander Wren'
  body: 'System: aft ramp actuator

    Status: intermittent stall at 40-45% travel

    Cause: suspected thermal binding in the screw jack


    Action: replace bearing set before Europa descent. Spare is in bin C-4.


    NOTE: Do NOT cycle the ramp manually above 40% until this is fixed. Yes, Luca, this means you.


    M. Lindqvist, Flight Engineer'
  setsFlag: 
