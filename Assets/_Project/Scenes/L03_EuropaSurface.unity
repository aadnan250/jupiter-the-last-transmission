  objectives:
  - text: Wait for the ramp
    requiredConversations: []
    requiredFlags:
    - ramp_open
  - text: Walk out onto Europa with the team
    requiredConversations: []
    requiredFlags:
    - quake_started
  - text: SURVIVE
    requiredConversations: []
    requiredFlags:
    - ambush_cleared
  - text: Reach Tiamat's lander (the green beacon, north-east)
    requiredConversations: []
    requiredFlags:
    - reached_tiamat
  - text: Search Tiamat's data box (read the cargo manifest)
    requiredConversations: []
    requiredFlags:
    - read_manifest
  - text: Cover Hana while she drills
    requiredConversations: []
    requiredFlags:
    - drill_done
  - text: 'KILL IT: knock it down, then keep firing'
    requiredConversations: []
    requiredFlags:
    - listener_killed
  - text: Get to the ascent vehicle Halcyon (by the base, red tower)
    requiredConversations: []
    requiredFlags:
    - ascent_unlocked
  - text: HOLD THE PAD until the hatch opens
    requiredConversations: []
    requiredFlags:
    - mara_lost
  - text: Board Halcyon
    requiredConversations: []
    requiredFlags:
    - boarded_halcyon
  completeText: Launch
