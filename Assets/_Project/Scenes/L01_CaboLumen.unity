  m_Name: 
  m_EditorClassIdentifier: Jupiter.Runtime::Jupiter.World.Readable
  title: Zara's drawing
  body: 'A crayon Jupiter, orange and brown stripes, with a big smiling face in the middle.


    Under it, in careful letters: FOR UNCLE SAM. TAKE IT ALL THE WAY.


    On the back: DOES IT HAVE A FACE? TELL ME.'
  setsFlag: took_zara_drawing
